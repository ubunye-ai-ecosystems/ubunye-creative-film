<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
<!-- Ubunye: with ThabangVision collaboration linked (CollabBinDir), the MSI installs for everyone, as
     0.6.0 did: kopanod is one shared, machine-wide copy (ubunye/packaging/windows/collab.wxs), which
     an "Only for me" install could not write. Without it, upstream's dual-scope policy is unchanged.
     Modified by Ubunye AI Ecosystems, 2026. -->
<?ifdef CollabBinDir?>
<?define UbunyeScope = "perMachine" ?>
<?else?>
<?define UbunyeScope = "perUserOrMachine" ?>
<?endif?>
  <Package Name="Ubunye Film" Manufacturer="Ubunye AI Ecosystems" Version="$(var.Version)" UpgradeCode="920776E7-7682-4688-8E8B-B25A5CAB0BF4" Scope="$(var.UbunyeScope)" Compressed="yes" Language="1033">
<?ifdef CollabBinDir?>
    <!-- Ubunye: read by install-policy.wxi (no scope page) and check-install-policy.ps1 -->
    <Property Id="UBUNYE_MACHINE_SCOPE" Value="1" />
<?endif?>
    <SummaryInformation Description="Ubunye Film video editor" Manufacturer="Ubunye AI Ecosystems" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Ubunye Film is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.thabangvision.com/tools/film" />
    <Property Id="ARPURLUPDATEINFO" Value="https://www.thabangvision.com/tools/film" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ubunye-ai-ecosystems/ubunye-creative-film/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Ubunye AI Ecosystems">
        <Directory Id="INSTALLFOLDER" Name="Ubunye Film" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Ubunye Film" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="FilmcraftFiles" />
<?ifdef CollabBinDir?>
      <!-- Ubunye: ThabangVision collaboration (kopanod), from ubunye/packaging/windows/collab.wxs -->
      <ComponentGroupRef Id="UbunyeCollabFiles" />
<?endif?>
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="6B0D5C35-3E0B-4B57-9C55-2F1C0E0A7F31">
        <File Id="FilmcraftNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="FilmcraftExe" Source="$(var.BinDir)\filmcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Ubunye Film" Description="Ubunye Film video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\filmcraft.exe" Value="[#FilmcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Ubunye Film" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\filmcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
