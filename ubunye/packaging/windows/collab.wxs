<?xml version="1.0" encoding="utf-8"?>
<!--
  Ubunye: ThabangVision collaboration inside the Ubunye Film MSI (Kopano slice S4).
  Linked by packaging/windows/package.ps1 when collab-package.ps1 sets UBUNYE_EXTRA_WXS, which
  also defines CollabBinDir (the folder holding kopanod.exe). filmcraft.wxs adds the component
  group to its one feature.

  Install: kopanod.exe goes beside filmcraft.exe and filmcraft-cli.exe (kopanod makes footage
  proxies with the CLI it finds beside itself). Nothing else happens at install time: Film sets
  up the service the first time it starts, as the signed-in user (apps/filmcraft/src/
  ubunye_collab.rs: device key, start at sign-in, start now).

  Uninstall (not an upgrade): start at sign-in is turned off for the user removing the app
  (kopanod autostart off, run as that user), then every kopanod running from this folder is
  stopped so its file can go. An upgrade only stops it; the new Film starts it again.
  Left on purpose: the service folder (%LOCALAPPDATA%\Kopano: the device key's name, shared
  projects), like Film's own projects. Other Windows users who used the app keep a start entry
  that points at the removed file; Windows skips it without a message.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="UbunyeCollabFiles" Directory="INSTALLFOLDER">
      <Component Id="UbunyeKopanod" Guid="1BD2572A-35E7-4C9B-8429-F729FD8D79ED">
        <File Id="KopanodExe" Source="$(var.CollabBinDir)\kopanod.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- WixQuietExec runs the command with no window; deferred actions read it from the
         property of the same name. Return="ignore": a leftover service never blocks removal. -->
    <SetProperty Id="UbunyeCollabAutostartOff" Sequence="execute" Before="UbunyeCollabAutostartOff"
        Value="&quot;[INSTALLFOLDER]kopanod.exe&quot; autostart off --home &quot;[LocalAppDataFolder]Kopano&quot;" />
    <CustomAction Id="UbunyeCollabAutostartOff" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
        Execute="deferred" Impersonate="yes" Return="ignore" />

    <SetProperty Id="UbunyeCollabStop" Sequence="execute" Before="UbunyeCollabStop"
        Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Get-Process -Name kopanod -ErrorAction SilentlyContinue | Where-Object Path -eq '[INSTALLFOLDER]kopanod.exe' | Stop-Process -Force; Start-Sleep -Milliseconds 500&quot;" />
    <CustomAction Id="UbunyeCollabStop" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
        Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="UbunyeCollabAutostartOff" Before="UbunyeCollabStop"
          Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UbunyeCollabStop" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
